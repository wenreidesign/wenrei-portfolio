         <pdfx:ecv-data>{"_id":"6a04985abe1723f99ac10ea8","style":{"background":"","colors":["#000000","#707070"],"columnLayoutOption":1,"fontBody":"roboto","fontHeading":"arimo","fontSize":1,"headerExtraSpacing":0,"isMetaDataDisabled":true,"layout":"double","layoutSize":"medium","lineHeightOption":2,"marginOption":1,"pageMarginOption":0,"record":"ResumeStyle","signaturePage":null},"header":{"contacts":"","customHeight":188,"dateOfBirth":"","email":"wenreidesign@gmail.com","extraField":"Portfolio: https://wenreidesign.super.site/","extraLink":"&lt;a id=\"ouc8gwmo96\" href=\"https://github.com/wenreidesign\" style=\"text-decoration: underline;\"&gt;&lt;u&gt;Github&lt;/u&gt;&lt;/a&gt;","height":100,"link":"&lt;a id=\"ng4b23pf9m\" href=\"http://linkedin.com/in/ramon-camacho-rojas\" style=\"text-decoration: underline;\"&gt;&lt;u&gt;Linkedin&lt;/u&gt;&lt;/a&gt;","location":"Barcelona, EspaÃ±a","name":"RAMÃ“N CAMACHO","nationality":"","phone":"+34627170268","photo":"","photoStyle":"round","record":"Header","showDateOfBirth":false,"showEmail":true,"showExtraField":true,"showExtraLink":true,"showLink":true,"showLocation":true,"showNationality":false,"showPhone":true,"showPhoto":false,"showTitle":true,"title":"UX/UI Product Designer","uppercaseName":true},"sections":[{"__t":"SummarySection","column":0,"enabled":true,"height":34,"items":[{"height":110,"id":"zvygcyprpq","record":"SummaryItem","alignment":"left","text":"Product Designer con 5 a&amp;#xF1;os de experiencia enfocado en web, especializado en Design Systems y accesibilidad. Dise&amp;#xF1;o flujos complejos en plataformas B2C, simplificando lo complicado para que cualquier usuario lo complete sin fricci&amp;#xF3;n. &lt;div&gt;Reci&amp;#xE9;n graduado como programador, conecto dise&amp;#xF1;o y desarrollo de forma directa: entiendo c&amp;#xF3;mo se construye lo que dise&amp;#xF1;o, lo que reduce fricciones en la implementaci&amp;#xF3;n y acelera la entrega.&lt;/div&gt;"}],"name":"","record":"SummarySection","showTitle":false},{"__t":"ActivitySection","column":0,"enabled":true,"height":34,"items":[{"dateRange":{"fromMonth":2,"fromYear":2026,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":4,"toYear":2026},"height":287,"id":"q62f03eeop","record":"ActivityItem","alignment":"left","bullets":["Desarrollo front-end con React, JavaScript, HTML y CSS, junto con back-end en Flask, Python, PostgreSQL y migraciones con Alembic.","ImplementaciÃ³n de autenticaciÃ³n JWT, rutas protegidas y gestiÃ³n de sesiones mediante LocalStorage.","Desarrollo de funcionalidades como Place Matcher estilo Tinder, sistema de reviews, chat entre usuarios y gestiÃ³n de establecimientos.","IntegraciÃ³n de APIs REST, subida de imÃ¡genes con Cloudinary y arquitectura basada en componentes reutilizables.","Trabajo colaborativo con Git/GitHub resolviendo merges, conflictos de integraciÃ³n y migraciones con Alembic.","DiseÃ±o de landing page responsive enfocada en experiencia de usuario y branding visual."],"description":"Desarrollo de una plataforma web pet-friendly - PetSpot - enfocada en descubrir, reservar y compartir lugares adaptados para mascotas.","link":"https://github.com/4GeeksAcademy/petspot-sp-131","location":"Barcelona, ES","showBullets":true,"showDateRange":true,"showDescription":true,"showLink":true,"showLocation":false,"title":"Full Stack Developer"}],"name":"","record":"ActivitySection"},{"__t":"ExperienceSection","column":0,"enabled":true,"height":34,"items":[{"dateRange":{"fromMonth":7,"fromYear":2023,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":6,"toYear":2024},"table":{"cols":2,"record":"TableItem","rows":[]},"height":207,"id":"agdt57i5ca","record":"ExperienceItem","alignment":"left","bullets":["RediseÃ±o de un trÃ¡mite digital de administraciÃ³n pÃºblica: evaluaciÃ³n heurÃ­stica del flujo y rediseÃ±o del acceso y la arquitectura de informaciÃ³n para reducir la fricciÃ³n de entrada.","DiseÃ±o de un prototipo interactivo validado con usuarios para IMAGIN, centrado en simplificar el flujo de solicitud.","DiseÃ±o e implementaciÃ³n de nuevos iconos y mejora de componentes del Design System de SEAT y CUPRA, garantizando coherencia visual y funcional.","ProducciÃ³n y ediciÃ³n de vÃ­deos promocionales, adaptaciÃ³n de anuncios para TMB, maquetaciÃ³n de boletines para RACC y apoyo en estrategias de marketing para IFEMA."],"companyLogo":"","description":"","link":"","location":"Barcelona, EspaÃ±a","position":"Studio Senior","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Deloitte Digital"},{"dateRange":{"fromMonth":2,"fromYear":2022,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":6,"toYear":2023},"table":{"cols":2,"record":"TableItem","rows":[]},"height":222,"id":"0uthk1z0fv","record":"ExperienceItem","alignment":"left","bullets":["DiseÃ±o y optimizaciÃ³n de mÃ¡s de 15 features clave desde wireframes responsivos bajo principios Mobile-First.","DiseÃ±o del flujo \"Book an Appointment\" para servicios de taller, logrando un aumento del 35% en citas online y desplegado en 47 paÃ­ses.","EjecuciÃ³n de pruebas de usabilidad y validaciÃ³n de hipÃ³tesis mediante prototipos interactivos.","RediseÃ±o de la arquitectura de la secciÃ³n FAQ aplicando criterios de UX y SEO.","DiseÃ±o, estandarizaciÃ³n y mantenimiento de componentes e iconos dentro del Design System."],"companyLogo":"https://enhancv.s3.amazonaws.com/company-logos-cache/c14torce.com.png","description":"","link":"","location":"Barcelona, EspaÃ±a","position":"Product Designer - web SEAT &amp;amp; CUPRA","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"c14torce.com"}],"name":"","record":"ExperienceSection","showCompanyLogos":false,"timelineWidth":136},{"__t":"TechnologySection","column":1,"enabled":true,"height":34,"items":[{"heig